.nav-area .menu
  display: grid
  margin-bottom: 8px
  // 液态玻璃：半透明背景 + 毛玻璃
  background: rgba(var(--block-rgb), 0.65)
  backdrop-filter: blur(12px)
  -webkit-backdrop-filter: blur(12px)
  box-shadow: $boxshadow-inset-block, 0 4px 16px rgba(0,0,0,0.08)
  padding: 2px
  border: 1px solid rgba(var(--block-border-rgb), 0.25)
  // 增大圆角，美化
  border-radius: $border-bar * 1.6
  grid-template-columns: repeat(hexo-config('menubar.columns'), 1fr)
  grid-gap: 2px
  overflow: hidden
  // 滚动条隐藏
  &::-webkit-scrollbar,
  &::-webkit-scrollbar-track-piece,
  &::-webkit-scrollbar-thumb
    display: none

  .nav-item
    box-sizing: border-box
    width: 100%
    min-height: 38px
    font-size: $fs-15
    font-weight: 500
    color: var(--text-p3)
    text-align: center
    position: relative
    display: flex
    flex-direction: column
    align-items: center
    justify-content: center
    // 子项圆角匹配外层
    border-radius: $border-bar * 1.3
    transition: background 0.22s ease, color 0.22s ease, transform 0.2s ease
    // 轻微按压感
    &:active
      transform: scale(0.96)

    img, svg
      height: 26px
      object-fit: contain
      filter: grayscale(100%) brightness(0.7) opacity(0.7)
      transition: filter 0.22s ease
    span
      text-overflow: ellipsis
      word-break: keep-all
      white-space: nowrap
      overflow: hidden
      max-width: 100%

    &.active, 
    &:hover
      color: var(--text-p1)
      // hover激活项也用玻璃质感
      background: rgba(var(--card-rgb), 0.45)
      img, svg
        filter: unset

    &.active::after
      content: ''
      position: absolute
      width: 16px
      height: 2px
      left: 50%
      transform: translateX(-50%)
      border-radius: 2px
      bottom: 3px
      background: currentColor



:root {
  /* 示例，替换成你主题原本的颜色 */
  --block: #ffffff;
  --block-rgb: 255, 255, 255;

  --card: #f7f8fa;
  --card-rgb: 247, 248, 250;

  --block-border: #e5e7eb;
  --block-border-rgb: 229, 231, 235;
}
