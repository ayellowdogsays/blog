// -----------------------------------------------------------------------------
// logo-wrap 头部Logo｜头像｜标题｜搜索
// -----------------------------------------------------------------------------
.logo-wrap
  display: flex
  align-items: center
  overflow: hidden
  min-height: 48px
  gap: 0.75rem          // 新增：统一元素间隙，替代部分margin

  img.avatar
    object-fit: cover

  img.icon
    object-fit: contain

  .icon
    width: 48px
    height: 48px
    margin-right: 0.25rem
    border-radius: 4px
    flex-shrink: 0

  a
    color: inherit
    display: flex
    align-items: center
    text-decoration: none  // 新增：清除下划线

  // 头像容器
  a.avatar
    display: block
    position: relative
    width: 48px
    height: 48px
    flex-shrink: 0
    border-radius: 50%
    overflow: hidden
    margin-right: 0.25rem

    div.bg
      width: 100%
      height: 100%
      background-size: cover
      background-position: center

    img.avatar
      margin: 2px
      width: "calc(100% - 2 * %s)" % @margin
      height: "calc(100% - 2 * %s)" % @margin
      border-radius: @width

    if hexo-config('style.animated_avatar.animate')
      div.bg
        trans1: opacity
        position: absolute
        opacity: 0 !important
        z-index: -1
        backface-visibility hidden  // 新增：消除旋转锯齿抖动

      @keyframes spin
        from
          transform: rotate(0deg)
        to
          transform: rotate(360deg)

    if hexo-config('style.animated_avatar.animate') == 'always'
      div.bg
        opacity: 1 !important
        animation: spin 4s linear infinite

    if hexo-config('style.animated_avatar.animate') == 'auto'
      &:hover
        div.bg
          opacity: 1 !important
          animation: spin 4s linear infinite

  // 站点标题
  a.title
    font-size: 1.5rem
    font-weight: 900
    color: inherit
    line-height: 1.2
    display: block
    position: relative
    flex-shrink: 1        // 新增：小屏幕允许收缩标题
    overflow: hidden

    .main
      color: var(--text)

    .sub
      color: var(--text-p1)
      trans2 opacity transform
      white-space: nowrap

    .hover
      position: absolute
      bottom: 0
      transform: translateY(8px)
      overflow: visible

    &:hover
      .normal
        opacity: 0
        transform: translateY(-8px)
      .hover
        transform: translateY(0)
        opacity: 1 !important

  // 搜索按钮 交互美化
  #search-button
    margin-left: auto
    flex-shrink: 0

    > a
      color: var(--text-p3)
      border-radius: 50%
      border: 1px solid var(--block-border)
      padding: .5rem
      background: var(--block)
      box-shadow: $boxshadow-inset-block
      trans2 color background transform
      text-decoration: none

      &:hover
        background: var(--card)
        color: $color-theme
        transform: scale(1.08)   // 新增hover轻微放大

      &:active
        transform: scale(0.95)   // 点击按压效果

      &:focus-visible
        outline: 2px solid $color-theme
        outline-offset: 2px
