.logo-wrap
  display: flex
  align-items: center
  gap: 0
  overflow: hidden
  min-height: 52px
  padding: 4px 8px
  border-radius: 8px
  transition: background 0.2s ease

  &:hover
    background rgba(0,0,0,0.04)

  img.avatar
    object-fit: cover
    width: 100%
    height: 100%

  img.icon
    object-fit: contain
    width: 100%
    height: 100%

  .icon
    width: 48px
    height: 48px
    margin-right: 1rem
    border-radius: 8px
    flex-shrink: 0
    box-shadow: 0 1px 4px rgba(0,0,0,0.08)
    overflow: hidden
    transition: transform 0.2s ease, box-shadow 0.2s ease

    &:hover
      transform scale(1.04)
      box-shadow 0 2px 8px rgba(0,0,0,0.12)

  a
    color: inherit
    display: flex
    align-items: center
    text-decoration none
    transition color 0.2s ease

    &:hover
      color #2563eb

  a.avatar
    display: block
    position: relative
    width: 48px
    height: 48px
    flex-shrink: 0
    border-radius: 50%
    overflow: hidden
    margin-right: 1rem
    box-shadow: 0 1px 6px rgba(0,0,0,0.1)
    transition: transform 0.2s ease, box-shadow 0.2s ease

    &:hover
      transform scale(1.05)
      box-shadow 0 3px 10px rgba(0,0,0,0.16)

    div.bg
      width: 100%
      height: 100%
      background-size: cover
      background-position center

    img.avatar
      margin: 2px
      width: calc(100% - 4px)
      height: calc(100% - 4px)
      border-radius: 50%
